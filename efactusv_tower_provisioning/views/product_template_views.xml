<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_template_form_tower_provisioning" model="ir.ui.view">
        <field name="name">product.template.form.tower.provisioning</field>
        <field name="model">product.template</field>
        <field
            name="inherit_id"
            ref="product_contract.product_template_form_contract_view"
        />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='contract']/group[1]" position="inside">
                <field
                    name="tower_provisioning_profile_id"
                    options="{'no_create': True}"
                    invisible="not is_contract"
                />
            </xpath>
        </field>
    </record>
</odoo>
