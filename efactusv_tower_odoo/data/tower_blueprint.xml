            ref="cetmix_tower_server.cx_tower_jet_state_stopped"
        />
        <field name="plan_id" ref="plan_stop_odoo" />
    </record>
    <record id="jet_action_start" model="cx.tower.jet.action">
        <field name="name">Start Odoo SaaS</field>
        <field name="reference">efactusv_odoo_start_action</field>
        <field name="jet_template_id" ref="jet_template_odoo_saas" />
        <field
            name="state_from_id"
            ref="cetmix_tower_server.cx_tower_jet_state_stopped"
        />
        <field
            name="state_transit_id"
            ref="cetmix_tower_server.cx_tower_jet_state_starting"
        />
        <field
            name="state_to_id"
            ref="cetmix_tower_server.cx_tower_jet_state_running"
        />
        <field name="plan_id" ref="plan_start_odoo" />
    </record>
    <record id="jet_action_destroy" model="cx.tower.jet.action">
        <field name="name">Destroy Odoo SaaS</field>
        <field name="reference">efactusv_odoo_destroy_action</field>
        <field name="jet_template_id" ref="jet_template_odoo_saas" />
        <field
            name="state_from_id"
            ref="cetmix_tower_server.cx_tower_jet_state_stopped"
        />
        <field
            name="state_transit_id"
            ref="cetmix_tower_server.cx_tower_jet_state_destroying"
        />
        <field name="plan_id" ref="plan_destroy_odoo" />
    </record>

    <record id="command_restart_odoo" model="cx.tower.command">
        <field name="name">Restart Odoo stack</field>
        <field name="reference">efactusv_odoo_restart</field>
        <field name="action">ssh_command</field>
        <field name="path">{{ base_dir }}/{{ instance_name }}</field>
        <field name="code">docker compose restart web</field>
        <field name="access_level">2</field>
    </record>
    <record id="plan_restart_odoo" model="cx.tower.plan">
        <field name="name">Restart efactusv Odoo SaaS instance</field>
        <field name="reference">efactusv_odoo_restart_plan</field>
        <field name="access_level">2</field>
