    <record id="jet_template_odoo_saas" model="cx.tower.jet.template">
        <field name="name">efactusv Odoo 18 SaaS</field>
        <field name="reference">efactusv_odoo_18_saas</field>
        <field name="show_in_create_wizard" eval="True" />
        <field
