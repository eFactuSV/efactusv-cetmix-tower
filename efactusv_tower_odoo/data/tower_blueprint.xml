    </record>
    <record id="plan_create_line_50" model="cx.tower.plan.line">
        <field name="sequence">50</field>
        <field name="plan_id" ref="plan_create_odoo" />
        <field name="command_id" ref="command_initialize_database" />
        <field name="use_sudo" eval="True" />
