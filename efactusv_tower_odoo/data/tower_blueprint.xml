        <field name="use_sudo" eval="True" />
    </record>
    <record id="plan_create_line_57" model="cx.tower.plan.line">
        <field name="sequence">57</field>
        <field name="plan_id" ref="plan_create_odoo" />
        <field name="command_id" ref="command_configure_customer" />
        <field name="use_sudo" eval="True" />
    </record>
    <record id="plan_create_line_60" model="cx.tower.plan.line">
        <field name="sequence">60</field>
        <field name="plan_id" ref="plan_create_odoo" />
        <field name="command_id" ref="command_start_odoo" />
        <field name="use_sudo" eval="True" />
    </record>
    <record id="plan_create_line_70" model="cx.tower.plan.line">
        <field name="sequence">70</field>
        <field name="plan_id" ref="plan_create_odoo" />
        <field name="command_id" ref="command_register_dns" />
    </record>
    <record id="plan_create_line_80" model="cx.tower.plan.line">
        <field name="sequence">80</field>
        <field name="plan_id" ref="plan_create_odoo" />
        <field name="command_id" ref="command_push_nginx" />
        <field name="use_sudo" eval="True" />
    </record>
    <record id="plan_create_line_90" model="cx.tower.plan.line">
