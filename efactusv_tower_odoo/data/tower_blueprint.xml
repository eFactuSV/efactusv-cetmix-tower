    <record id="plan_start_odoo" model="cx.tower.plan">
        <field name="name">Start efactusv Odoo SaaS instance</field>
        <field name="reference">efactusv_odoo_start_plan</field>
        <field name="access_level">2</field>
    </record>
    <record id="plan_start_line" model="cx.tower.plan.line">
        <field name="plan_id" ref="plan_start_odoo" />
        <field name="command_id" ref="command_start_odoo" />
