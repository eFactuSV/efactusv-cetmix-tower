        <field name="reference">efactusv_odoo_stop_action</field>
        <field name="jet_template_id" ref="jet_template_odoo_saas" />
        <field
            name="state_from_id"
            ref="cetmix_tower_server.cx_tower_jet_state_running"
        />
        <field
            name="state_transit_id"
            ref="cetmix_tower_server.cx_tower_jet_state_stopping"
