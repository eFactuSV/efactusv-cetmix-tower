            ref="cetmix_tower_server.cx_tower_jet_state_stopped"
        />
        <field
            name="state_on_contract_reactivate_id"
            ref="cetmix_tower_server.cx_tower_jet_state_running"
        />
    </record>
    <record id="jet_action_create" model="cx.tower.jet.action">
        <field name="name">Create Odoo SaaS</field>
        <field name="reference">efactusv_odoo_create</field>
        <field name="jet_template_id" ref="jet_template_odoo_saas" />
        <field
            name="state_transit_id"
            ref="cetmix_tower_server.cx_tower_jet_state_starting"
