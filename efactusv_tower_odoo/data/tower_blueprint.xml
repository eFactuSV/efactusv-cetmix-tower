    </record>
    <record id="plan_stop_odoo" model="cx.tower.plan">
        <field name="name">Stop efactusv Odoo SaaS instance</field>
        <field name="reference">efactusv_odoo_stop_plan</field>
        <field name="access_level">2</field>
    </record>
    <record id="plan_stop_line" model="cx.tower.plan.line">
        <field name="plan_id" ref="plan_stop_odoo" />
        <field name="command_id" ref="command_stop_odoo" />
        <field name="use_sudo" eval="True" />
    </record>
