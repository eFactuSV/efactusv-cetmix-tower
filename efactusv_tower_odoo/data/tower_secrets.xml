<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="1">
    <record id="key_odoo_db_password" model="cx.tower.key">
        <field name="name">Odoo database password</field>
        <field name="reference">EFACTUSV_ODOO_DB_PASSWORD</field>
        <field name="key_type">s</field>
    </record>
    <record id="key_odoo_admin_password" model="cx.tower.key">
        <field name="name">Odoo initial administrator password</field>
        <field name="reference">EFACTUSV_ODOO_ADMIN_PASSWORD</field>
        <field name="key_type">s</field>
    </record>
    <record id="key_ovh_application_key" model="cx.tower.key">
        <field name="name">OVH application key</field>
        <field name="reference">OVH_APPLICATION_KEY</field>
        <field name="key_type">s</field>
    </record>
    <record id="key_ovh_application_secret" model="cx.tower.key">
        <field name="name">OVH application secret</field>
        <field name="reference">OVH_APPLICATION_SECRET</field>
        <field name="key_type">s</field>
    </record>
    <record id="key_ovh_consumer_key" model="cx.tower.key">
        <field name="name">OVH consumer key</field>
        <field name="reference">OVH_CONSUMER_KEY</field>
        <field name="key_type">s</field>
    </record>
</odoo>
