#: code:addons/cetmix_tower_server/models/cx_tower_command.py:0
msgid ""
"Python 'dnspython' library. <a href='https://dnspython.readthedocs.io' "
"target='_blank'>Documentation</a>.<ul><li><code>dns.resolver</code>: wrapped"
" dnspython. Use <code>dns.resolver.resolve(hostname, \"A\")</code> for DNS "
"lookups.</li><li><code>dns.reversename</code>: wrapped dnspython. Use "
"<code>dns.reversename.from_address(\"8.8.8.8\")</code> to build and reverse "
"PTR records.</li><li><code>dns.exception</code>: wrapped dnspython. Catch "
"<code>dns.exception.DNSException</code> to handle DNS-related "
"errors.</li></ul>"
msgstr ""
"Biblioteca 'dnspython' de Python. <a href='https://dnspython.readthedocs.io'"
" target='_blank'>Documentación</a>.<ul><li><code>dns.resolver</code>: "
"envoltorio de dnspython. Use <code>dns.resolver.resolve(hostname, "
"\"A\")</code> para búsquedas DNS.</li><li><code>dns.reversename</code>: "
"envoltorio de dnspython. Use "
"<code>dns.reversename.from_address(\"8.8.8.8\")</code> para construir y "
"revertir registros PTR.</li><li><code>dns.exception</code>: envoltorio de "
"dnspython. Capture <code>dns.exception.DNSException</code> para manejar "
"errores relacionados con DNS.</li></ul>"

