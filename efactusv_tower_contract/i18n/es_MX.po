#: model:ir.model.fields,help:efactusv_tower_contract.field_contract_contract__tower_jet_template_id
msgid "Jet template used to create new instances for this contract"
msgstr ""
"Plantilla de jet usada para crear nuevas instancias para este contrato"

#. module: efactusv_tower_contract
#: model:ir.model.fields,help:efactusv_tower_contract.field_cx_tower_jet_template__state_on_contract_terminate_id
msgid ""
"Jets linked to a contract are brought to this state when the contract is "
"terminated. Leave empty to keep the jet running."
msgstr ""
"Los jets vinculados a un contrato se llevan a este estado cuando el contrato"
" se termina. Deje vacío para mantener el jet en ejecución."

#. module: efactusv_tower_contract
#: model:ir.model.fields,help:efactusv_tower_contract.field_cx_tower_jet_template__state_on_contract_reactivate_id
msgid ""
"Jets linked to a contract are brought to this state when the contract "
"termination is cancelled. Leave empty to keep the jet in its current state."
msgstr ""
"Los jets vinculados a un contrato se llevan a este estado cuando se cancela "
"la terminación del contrato. Deje vacío para mantener el jet en su estado "
"actual."

#. module: efactusv_tower_contract
#. odoo-python
#: code:addons/efactusv_tower_contract/models/contract_contract.py:0
msgid ""
"Please configure both the instance template and the instance server on the "
"contract first."
msgstr ""
"Primero configure la plantilla de la instancia y el servidor de la instancia"
" en el contrato."

