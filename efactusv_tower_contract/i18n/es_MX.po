#. module: efactusv_tower_contract
#. odoo-python
#: code:addons/efactusv_tower_contract/models/contract_contract.py:0
msgid ""
"Failed to bring instance %(jet)s to state %(state)s. Check the instance logs"
" in Cetmix Tower."
msgstr ""
"No se pudo llevar la instancia %(jet)s al estado %(state)s. Revise los "
"registros de la instancia en Cetmix Tower."

#. module: efactusv_tower_contract
#. odoo-python
#: code:addons/efactusv_tower_contract/models/contract_contract.py:0
msgid ""
"Failed to create the instance. Check the jet limit on the server and the "
"template settings."
msgstr ""
"No se pudo crear la instancia. Revise el límite de jets del servidor y la "
"configuración de la plantilla."

#. module: efactusv_tower_contract
#: model:ir.model.fields,field_description:efactusv_tower_contract.field_contract_contract__tower_server_id
