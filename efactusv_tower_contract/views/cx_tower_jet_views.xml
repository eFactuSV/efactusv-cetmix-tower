<odoo>
    <record id="cx_tower_jet_view_form" model="ir.ui.view">
        <field name="name">cx.tower.jet.form.contract</field>
        <field name="model">cx.tower.jet</field>
        <field name="inherit_id" ref="cetmix_tower_server.cx_tower_jet_view_form" />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    name="action_open_contract"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-file-text-o"
                    string="Contract"
                    invisible="not contract_id"
                />
            </div>
            <field name="partner_id" position="after">
                <field
                    name="contract_id"
                    domain="['|', ('partner_id', '=', partner_id), ('partner_id', '=', False)]"
                />
            </field>
        </field>
    </record>

    <record id="cx_tower_jet_view_search" model="ir.ui.view">
        <field name="name">cx.tower.jet.search.contract</field>
        <field name="model">cx.tower.jet</field>
        <field name="inherit_id" ref="cetmix_tower_server.cx_tower_jet_view_search" />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="contract_id" />
            </field>
        </field>
    </record>
</odoo>
